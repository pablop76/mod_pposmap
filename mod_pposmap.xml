<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
    <name>MOD_PPOSMAP_NAME</name>
    <version>1.1.4</version>
    <author>pablop76</author>
    <creationDate>04.07.2026</creationDate>
    <description>MOD_PPOSMAP_DESCRIPTION</description>
    <namespace path="src">Pablop76\Module\Pposmap</namespace>
    <files>
        <folder module="mod_pposmap">services</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
        <folder>language</folder>
    </files>
    <scriptfile>script.php</scriptfile>
    <media destination="mod_pposmap" folder="media">
        <filename>joomla.asset.json</filename>
        <folder>js</folder>
        <folder>css</folder>
    </media>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="mapboxorleaflet"
                    type="list"
                    label="MOD_PPOSMAP_CHOICEMAPBOXLEAFLET"
                    default="0"
                >
                    <option value="0">
                        MOD_PPOSMAP_MAPBOXCHOICE</option>
                    <option value="1">
                        MOD_PPOSMAP_LEAFLETCHOICE</option>
                </field>
                <field
                    name="tokenmapbox"
                    type="text"
                    label="MOD_PPOSMAP_TOKEN_MAPBOX"
                    showon="mapboxorleaflet:0"
                >
                </field>
                <field
                    name="stylemapbox"
                    type="text"
                    label="MOD_PPOSMAP_STYLE_MAPBOX"
                    showon="mapboxorleaflet:0"
                >
                </field>
                <!--
                    Celowo type="text", NIE type="url": adres z polami {z}/{x}/{y} oraz
                    ścieżka względna do własnych kafelków nie przechodzą walidacji
                    przeglądarki i blokują zapis całego formularza modułu.
                -->
                <field
                    name="tileurl"
                    type="text"
                    default=""
                    label="MOD_PPOSMAP_TILE_URL"
                    description="MOD_PPOSMAP_TILE_URL_DESC"
                    showon="mapboxorleaflet:1"
                    filter="string"
                />
                <field
                    name="tileattribution"
                    type="text"
                    default=""
                    label="MOD_PPOSMAP_TILE_ATTRIBUTION"
                    description="MOD_PPOSMAP_TILE_ATTRIBUTION_DESC"
                    showon="mapboxorleaflet:1"
                    filter="safehtml"
                />
                <field
                    name="tileminzoom"
                    type="number"
                    default=""
                    min="0"
                    max="22"
                    step="1"
                    label="MOD_PPOSMAP_TILE_MIN_ZOOM"
                    description="MOD_PPOSMAP_TILE_MIN_ZOOM_DESC"
                    showon="mapboxorleaflet:1"
                />
                <field
                    name="tilemaxzoom"
                    type="number"
                    default=""
                    min="0"
                    max="22"
                    step="1"
                    label="MOD_PPOSMAP_TILE_MAX_ZOOM"
                    description="MOD_PPOSMAP_TILE_MAX_ZOOM_DESC"
                    showon="mapboxorleaflet:1"
                />
                <field
                    name="groupscontrol"
                    showon="mapboxorleaflet:1"
                    type="radio"
                    default="0"
                    label="MOD_PPOSMAP_LAYER_GROUPS"
                    description="MOD_PPOSMAP_DESRIPTION_GROUPS"
                    layout="joomla.form.field.radio.switcher">
                    <option value="0">JHIDE</option>
                    <option value="1">JSHOW</option>
                </field>
                <field
                    name="listofpoints"
                    type="subform"
                    label="MOD_PPOSMAP_SUBFORM_FIELD"
                    description="MOD_PPOSMAP_SUBFORM_FIELD_DESC"
                    multiple="true"
                >
                    <form>
                        <field
                            name="longitudemapbox"
                            type="number"
                            label="MOD_PPOSMAP_LONGITUDE"
                            first="-180"
                            last="180"
                            step="0.000001"
                        >
                        </field>
                        <field
                            name="latitudemapbox"
                            type="number"
                            label="MOD_PPOSMAP_LATITUDE"
                            first="-90"
                            last="90"
                            step="0.000001"
                        >
                        </field>
                        <field
                            name="geotitle"
                            type="text"
                            label="MOD_PPOSMAP_GEOTITLE"
                            filter="raw"
                        >
                        </field>
                        <field
                            name="geodescription"
                            type="text"
                            label="MOD_PPOSMAP_GEODESCRIPTION"
                            filter="raw"
                        >
                        </field>
                        <field
                            name="openinghours"
                            type="text"
                            label="MOD_PPOSMAP_OPENINGHOURS"
                            filter="raw"
                        >
                        </field>
                        <field
                            name="telephonevalue"
                            type="telephone"
                            default=""
                            label="MOD_PPOSMAP_TELEPHONE"
                            filter="string"
                        >
                        </field>
                        <!-- Poniższe pola zasilają dane strukturalne Schema.org.
                             PostalAddress wymaga rozbicia adresu na składniki,
                             więc nie da się tego wziąć z pola opisu. -->
                        <field
                            name="streetaddress"
                            type="text"
                            label="MOD_PPOSMAP_STREET_ADDRESS"
                            description="MOD_PPOSMAP_STREET_ADDRESS_DESC"
                            filter="string"
                        />
                        <field
                            name="postalcode"
                            type="text"
                            label="MOD_PPOSMAP_POSTAL_CODE"
                            filter="string"
                        />
                        <field
                            name="addresslocality"
                            type="text"
                            label="MOD_PPOSMAP_ADDRESS_LOCALITY"
                            filter="string"
                        />
                        <field
                            name="schemaopeninghours"
                            type="textarea"
                            rows="3"
                            label="MOD_PPOSMAP_SCHEMA_OPENING_HOURS"
                            description="MOD_PPOSMAP_SCHEMA_OPENING_HOURS_DESC"
                            filter="string"
                        />
                        <field
                            name="pointurl"
                            type="text"
                            label="MOD_PPOSMAP_POINT_URL"
                            description="MOD_PPOSMAP_POINT_URL_DESC"
                            filter="string"
                        />
                        <field
                            name="sameas"
                            type="textarea"
                            rows="2"
                            label="MOD_PPOSMAP_SAME_AS"
                            description="MOD_PPOSMAP_SAME_AS_DESC"
                            filter="string"
                        />
                        <field
                            name="popupimage"
                            type="accessiblemedia"
                            directory="stories"
                            label="MOD_PPOSMAP_POPUP_IMAGE"
                            description="MOD_PPOSMAP_POPUP_IMAGE_DESC" />
                        <field
                            name="pointmarker"
                            type="accessiblemedia"
                            label="MOD_PPOSMAP_POINT_MARKER"
                            description="MOD_PPOSMAP_POINT_MARKER_DESC" />
                        <field
                            name="layergroup"
                            type="text"
                            label="MOD_PPOSMAP_LAYER_GROUP_NAME"
                            showon="groupscontrol:1"
                        >
                        </field>
                    </form>
                </field>
            </fieldset>
            <fieldset name="display" label="MOD_PPOSMAP_FIELDSET_DISPLAY">
                <field
                    name="zoommapbox"
                    type="integer"
                    label="MOD_PPOSMAP_ZOOM"
                    first="0" last="22" step="1"
                    default="7"
                >
                </field>
                <field
                    name="mapheight"
                    type="text"
                    default=""
                    label="MOD_PPOSMAP_MAP_HEIGHT"
                    description="MOD_PPOSMAP_MAP_HEIGHT_DESC"
                />
                <field
                    name="mapheight_mobile"
                    type="text"
                    default=""
                    label="MOD_PPOSMAP_MAP_HEIGHT_MOBILE"
                    description="MOD_PPOSMAP_MAP_HEIGHT_MOBILE_DESC"
                />
                <field
                    name="markermapbox"
                    type="accessiblemedia"
                    label="MOD_PPOSMAP_MARKER"
                    description="MOD_PPOSMAP_MARKER_DESC"
                >
                </field>
                <field
                    name="markerwidth"
                    type="number"
                    default=""
                    min="1"
                    max="512"
                    step="1"
                    label="MOD_PPOSMAP_MARKER_WIDTH"
                    description="MOD_PPOSMAP_MARKER_WIDTH_DESC"
                />
                <field
                    name="markerheight"
                    type="number"
                    default=""
                    min="1"
                    max="512"
                    step="1"
                    label="MOD_PPOSMAP_MARKER_HEIGHT"
                    description="MOD_PPOSMAP_MARKER_HEIGHT_DESC"
                />
                <field
                    name="markeranchor"
                    type="list"
                    default="bottom"
                    label="MOD_PPOSMAP_MARKER_ANCHOR"
                    description="MOD_PPOSMAP_MARKER_ANCHOR_DESC"
                >
                    <option value="bottom">MOD_PPOSMAP_MARKER_ANCHOR_BOTTOM</option>
                    <option value="center">MOD_PPOSMAP_MARKER_ANCHOR_CENTER</option>
                    <option value="top">MOD_PPOSMAP_MARKER_ANCHOR_TOP</option>
                </field>
                <field
                    name="pointslistmapbox"
                    type="radio"
                    default="0"
                    label="MOD_PPOSMAP_SHOW_LIST_POINTS"
                    description="MOD_PPOSMAP_SHOW_LIST_POINTS_DESC"
                    layout="joomla.form.field.radio.switcher">
                    <option value="0">JHIDE</option>
                    <option value="1">JSHOW</option>
                </field>
                <field
                    name="listwidth"
                    type="text"
                    default=""
                    label="MOD_PPOSMAP_LIST_WIDTH"
                    description="MOD_PPOSMAP_LIST_WIDTH_DESC"
                    showon="pointslistmapbox:1"
                />
                <field
                    name="viewbuttontext"
                    type="text"
                    default=""
                    label="MOD_PPOSMAP_VIEW_BUTTON_TEXT"
                    description="MOD_PPOSMAP_VIEW_BUTTON_TEXT_DESC"
                    showon="pointslistmapbox:1"
                    filter="string"
                />
                <field
                    name="viewbuttonclass"
                    type="text"
                    default=""
                    label="MOD_PPOSMAP_VIEW_BUTTON_CLASS"
                    description="MOD_PPOSMAP_VIEW_BUTTON_CLASS_DESC"
                    showon="pointslistmapbox:1"
                    filter="string"
                />
                <field
                    name="addschema"
                    type="radio"
                    default="1"
                    label="MOD_PPOSMAP_ADD_SCHEMA"
                    description="MOD_PPOSMAP_ADD_SCHEMA_DESC"
                    layout="joomla.form.field.radio.switcher">
                    <option value="0">JHIDE</option>
                    <option value="1">JSHOW</option>
                </field>
                <field
                    name="schematype"
                    type="list"
                    default="Place"
                    label="MOD_PPOSMAP_SCHEMA_TYPE"
                    description="MOD_PPOSMAP_SCHEMA_TYPE_DESC"
                    showon="addschema:1"
                >
                    <option value="Place">MOD_PPOSMAP_SCHEMA_TYPE_PLACE</option>
                    <option value="TouristAttraction">MOD_PPOSMAP_SCHEMA_TYPE_TOURISTATTRACTION</option>
                    <option value="LocalBusiness">MOD_PPOSMAP_SCHEMA_TYPE_LOCALBUSINESS</option>
                    <option value="Store">MOD_PPOSMAP_SCHEMA_TYPE_STORE</option>
                    <option value="Restaurant">MOD_PPOSMAP_SCHEMA_TYPE_RESTAURANT</option>
                    <option value="MedicalBusiness">MOD_PPOSMAP_SCHEMA_TYPE_MEDICALBUSINESS</option>
                    <option value="AutomotiveBusiness">MOD_PPOSMAP_SCHEMA_TYPE_AUTOMOTIVEBUSINESS</option>
                    <option value="ProfessionalService">MOD_PPOSMAP_SCHEMA_TYPE_PROFESSIONALSERVICE</option>
                    <option value="LodgingBusiness">MOD_PPOSMAP_SCHEMA_TYPE_LODGINGBUSINESS</option>
                </field>
                <field
                    name="schemamenuitems"
                    type="menuitem"
                    multiple="true"
                    default=""
                    label="MOD_PPOSMAP_SCHEMA_MENU_ITEMS"
                    description="MOD_PPOSMAP_SCHEMA_MENU_ITEMS_DESC"
                    showon="addschema:1"
                />
                <field
                    name="schemaownlocations"
                    type="radio"
                    default="0"
                    label="MOD_PPOSMAP_SCHEMA_OWN_LOCATIONS"
                    description="MOD_PPOSMAP_SCHEMA_OWN_LOCATIONS_DESC"
                    showon="addschema:1[AND]schematype!:Place,TouristAttraction"
                    layout="joomla.form.field.radio.switcher">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="addresscountry"
                    type="text"
                    default=""
                    label="MOD_PPOSMAP_ADDRESS_COUNTRY"
                    description="MOD_PPOSMAP_ADDRESS_COUNTRY_DESC"
                    showon="addschema:1"
                    filter="string"
                />
                <field
                    name="clustermarkers"
                    type="radio"
                    default="0"
                    label="MOD_PPOSMAP_CLUSTER_MARKERS"
                    description="MOD_PPOSMAP_CLUSTER_MARKERS_DESC"
                    layout="joomla.form.field.radio.switcher">
                    <option value="0">JHIDE</option>
                    <option value="1">JSHOW</option>
                </field>
            </fieldset>
            <fieldset name="about" label="MOD_PPOSMAP_FIELDSET_ABOUT">
                <field
                    name="pposmap_credit"
                    type="note"
                    heading="h4"
                    label="MOD_PPOSMAP_CREDIT_LABEL"
                    description="MOD_PPOSMAP_CREDIT_DESC"
                />
            </fieldset>
        </fields>
    </config>
    <updateservers>
        <server type="extension" name="Pposmap Module Updates">
            https://raw.githubusercontent.com/pablop76/mod_pposmap/release/updates.xml</server>
    </updateservers>
</extension>