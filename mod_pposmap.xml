<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
    <name>MOD_PPOSMAP_NAME</name>
    <version>1.2.0</version>
    <author>pablop76</author>
    <creationDate>12.08.2026</creationDate>
    <description>MOD_PPOSMAP_DESCRIPTION</description>
    <namespace path="src">Pablop76\Module\Pposmap</namespace>
    <files>
        <folder module="mod_pposmap">services</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
        <folder>language</folder>
    </files>
    <scriptfile>script.php</scriptfile>
    <media destination="mod_pposmap" folder="media">
        <filename>joomla.asset.json</filename>
        <folder>js</folder>
        <folder>css</folder>
    </media>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="mapboxorleaflet"
                    type="list"
                    label="MOD_PPOSMAP_CHOICEMAPBOXLEAFLET"
                    default="0"
                >
                    <option value="0">
                        MOD_PPOSMAP_MAPBOXCHOICE</option>
                    <option value="1">
                        MOD_PPOSMAP_LEAFLETCHOICE</option>
                </field>
                <field
                    name="tokenmapbox"
                    type="text"
                    label="MOD_PPOSMAP_TOKEN_MAPBOX"
                    showon="mapboxorleaflet:0"
                >
                </field>
                <field
                    name="stylemapbox"
                    type="text"
                    label="MOD_PPOSMAP_STYLE_MAPBOX"
                    showon="mapboxorleaflet:0"
                >
                </field>
                <!--
                    Celowo type="text", NIE type="url": adres z polami {z}/{x}/{y} oraz
                    ścieżka względna do własnych kafelków nie przechodzą walidacji
                    przeglądarki i blokują zapis całego formularza modułu.
                -->
                <field
                    name="tileurl"
                    type="text"
                    default=""
                    label="MOD_PPOSMAP_TILE_URL"
                    description="MOD_PPOSMAP_TILE_URL_DESC"
                    showon="mapboxorleaflet:1"
                    filter="string"
                />
                <field
                    name="tileattribution"
                    type="text"
                    default=""
                    label="MOD_PPOSMAP_TILE_ATTRIBUTION"
                    description="MOD_PPOSMAP_TILE_ATTRIBUTION_DESC"
                    showon="mapboxorleaflet:1"
                    filter="safehtml"
                />
                <field
                    name="tileminzoom"
                    type="number"
                    default=""
                    min="0"
                    max="22"
                    step="1"
                    label="MOD_PPOSMAP_TILE_MIN_ZOOM"
                    description="MOD_PPOSMAP_TILE_MIN_ZOOM_DESC"
                    showon="mapboxorleaflet:1"
                />
                <field
                    name="tilemaxzoom"
                    type="number"
                    default=""
                    min="0"
                    max="22"
                    step="1"
                    label="MOD_PPOSMAP_TILE_MAX_ZOOM"
                    description="MOD_PPOSMAP_TILE_MAX_ZOOM_DESC"
                    showon="mapboxorleaflet:1"
                />
                <field
                    name="groupscontrol"
                    showon="mapboxorleaflet:1"
                    type="radio"
                    default="0"
                    label="MOD_PPOSMAP_LAYER_GROUPS"
                    description="MOD_PPOSMAP_DESRIPTION_GROUPS"
                    layout="joomla.form.field.radio.switcher">
                    <option value="0">JHIDE</option>
                    <option value="1">JSHOW</option>
                </field>
                <field
                    name="listofpoints"
                    type="subform"
                    label="MOD_PPOSMAP_SUBFORM_FIELD"
                    description="MOD_PPOSMAP_SUBFORM_FIELD_DESC"
                    multiple="true"
                >
                    <form>
                        <field
                            name="longitudemapbox"
                            type="number"
                            label="MOD_PPOSMAP_LONGITUDE"
                            first="-180"
                            last="180"
                            step="0.000001"
                        >
                        </field>
                        <field
                            name="latitudemapbox"
                            type="number"
                            label="MOD_PPOSMAP_LATITUDE"
                            first="-90"
                            last="90"
                            step="0.000001"
                        >
                        </field>
                        <!-- Tytuł bez znaczników: w nagłówku listy i dymka nie ma po nich czego szukać. -->
                        <field
                            name="geotitle"
                            type="text"
                            label="MOD_PPOSMAP_GEOTITLE"
                            filter="string"
                        >
                        </field>
                        <!-- safehtml zamiast raw: przepuszcza pogrubienie, odnośniki czy listę,
                             ale odsiewa script i atrybuty zdarzeń. -->
                        <field
                            name="geodescription"
                            type="textarea"
                            rows="4"
                            label="MOD_PPOSMAP_GEODESCRIPTION"
                            description="MOD_PPOSMAP_GEODESCRIPTION_DESC"
                            filter="safehtml"
                        >
                        </field>
                        <field
                            name="openinghours"
                            type="textarea"
                            rows="2"
                            label="MOD_PPOSMAP_OPENINGHOURS"
                            description="MOD_PPOSMAP_OPENINGHOURS_DESC"
                            filter="string"
                        >
                        </field>
                        <field
                            name="telephonevalue"
                            type="telephone"
                            default=""
                            label="MOD_PPOSMAP_TELEPHONE"
                            filter="string"
                        >
                        </field>
                        <!-- Poniższe pola zasilają dane strukturalne Schema.org.
                             PostalAddress wymaga rozbicia adresu na składniki,
                             więc nie da się tego wziąć z pola opisu. -->
                        <field
                            name="streetaddress"
                            type="text"
                            label="MOD_PPOSMAP_STREET_ADDRESS"
                            description="MOD_PPOSMAP_STREET_ADDRESS_DESC"
                            filter="string"
                        />
                        <field
                            name="postalcode"
                            type="text"
                            label="MOD_PPOSMAP_POSTAL_CODE"
                            filter="string"
                        />
                        <field
                            name="addresslocality"
                            type="text"
                            label="MOD_PPOSMAP_ADDRESS_LOCALITY"
                            filter="string"
                        />
                        <field
                            name="schemaopeninghours"
                            type="textarea"
                            rows="3"
                            label="MOD_PPOSMAP_SCHEMA_OPENING_HOURS"
                            description="MOD_PPOSMAP_SCHEMA_OPENING_HOURS_DESC"
                            filter="string"
                        />
                        <field
                            name="pointurl"
                            type="text"
                            label="MOD_PPOSMAP_POINT_URL"
                            description="MOD_PPOSMAP_POINT_URL_DESC"
                            filter="string"
                        />
                        <field
                            name="sameas"
                            type="textarea"
                            rows="2"
                            label="MOD_PPOSMAP_SAME_AS"
                            description="MOD_PPOSMAP_SAME_AS_DESC"
                            filter="string"
                        />
                        <field
                            name="popupimage"
                            type="accessiblemedia"
                            directory="stories"
                            label="MOD_PPOSMAP_POPUP_IMAGE"
                            description="MOD_PPOSMAP_POPUP_IMAGE_DESC" />
                        <field
                            name="pointmarker"
                            type="accessiblemedia"
                            label="MOD_PPOSMAP_POINT_MARKER"
                            description="MOD_PPOSMAP_POINT_MARKER_DESC" />
                        <field
                            name="layergroup"
                            type="text"
                            label="MOD_PPOSMAP_LAYER_GROUP_NAME"
                            showon="groupscontrol:1"
                        >
                        </field>
                    </form>
                </field>
            </fieldset>
            <fieldset name="display" label="MOD_PPOSMAP_FIELDSET_DISPLAY">
                <field
                    name="zoommapbox"
                    type="integer"
                    label="MOD_PPOSMAP_ZOOM"
                    first="0" last="22" step="1"
                    default="7"
                >
                </field>
                <field
                    name="mapheight"
                    type="text"
                    default=""
                    label="MOD_PPOSMAP_MAP_HEIGHT"
                    description="MOD_PPOSMAP_MAP_HEIGHT_DESC"
                />
                <field
                    name="mapheight_mobile"
                    type="text"
                    default=""
                    label="MOD_PPOSMAP_MAP_HEIGHT_MOBILE"
                    description="MOD_PPOSMAP_MAP_HEIGHT_MOBILE_DESC"
                />
                <field
                    name="markermapbox"
                    type="accessiblemedia"
                    label="MOD_PPOSMAP_MARKER"
                    description="MOD_PPOSMAP_MARKER_DESC"
                >
                </field>
                <field
                    name="markerwidth"
                    type="number"
                    default=""
                    min="1"
                    max="512"
                    step="1"
                    label="MOD_PPOSMAP_MARKER_WIDTH"
                    description="MOD_PPOSMAP_MARKER_WIDTH_DESC"
                />
                <field
                    name="markerheight"
                    type="number"
                    default=""
                    min="1"
                    max="512"
                    step="1"
                    label="MOD_PPOSMAP_MARKER_HEIGHT"
                    description="MOD_PPOSMAP_MARKER_HEIGHT_DESC"
                />
                <field
                    name="markeranchor"
                    type="list"
                    default="bottom"
                    label="MOD_PPOSMAP_MARKER_ANCHOR"
                    description="MOD_PPOSMAP_MARKER_ANCHOR_DESC"
                >
                    <option value="bottom">MOD_PPOSMAP_MARKER_ANCHOR_BOTTOM</option>
                    <option value="center">MOD_PPOSMAP_MARKER_ANCHOR_CENTER</option>
                    <option value="top">MOD_PPOSMAP_MARKER_ANCHOR_TOP</option>
                </field>
                <field
                    name="pointslistmapbox"
                    type="radio"
                    default="0"
                    label="MOD_PPOSMAP_SHOW_LIST_POINTS"
                    description="MOD_PPOSMAP_SHOW_LIST_POINTS_DESC"
                    layout="joomla.form.field.radio.switcher">
                    <option value="0">JHIDE</option>
                    <option value="1">JSHOW</option>
                </field>
                <field
                    name="listwidth"
                    type="text"
                    default=""
                    label="MOD_PPOSMAP_LIST_WIDTH"
                    description="MOD_PPOSMAP_LIST_WIDTH_DESC"
                    showon="pointslistmapbox:1"
                />
                <field
                    name="viewbuttontext"
                    type="text"
                    default=""
                    label="MOD_PPOSMAP_VIEW_BUTTON_TEXT"
                    description="MOD_PPOSMAP_VIEW_BUTTON_TEXT_DESC"
                    showon="pointslistmapbox:1"
                    filter="string"
                />
                <field
                    name="viewbuttonclass"
                    type="text"
                    default=""
                    label="MOD_PPOSMAP_VIEW_BUTTON_CLASS"
                    description="MOD_PPOSMAP_VIEW_BUTTON_CLASS_DESC"
                    showon="pointslistmapbox:1"
                    filter="string"
                />
                <field
                    name="addschema"
                    type="radio"
                    default="1"
                    label="MOD_PPOSMAP_ADD_SCHEMA"
                    description="MOD_PPOSMAP_ADD_SCHEMA_DESC"
                    layout="joomla.form.field.radio.switcher">
                    <option value="0">JHIDE</option>
                    <option value="1">JSHOW</option>
                </field>
                <field
                    name="schematype"
                    type="list"
                    default="Place"
                    label="MOD_PPOSMAP_SCHEMA_TYPE"
                    description="MOD_PPOSMAP_SCHEMA_TYPE_DESC"
                    showon="addschema:1"
                >
                    <option value="Place">MOD_PPOSMAP_SCHEMA_TYPE_PLACE</option>
                    <option value="TouristAttraction">MOD_PPOSMAP_SCHEMA_TYPE_TOURISTATTRACTION</option>
                    <option value="LocalBusiness">MOD_PPOSMAP_SCHEMA_TYPE_LOCALBUSINESS</option>
                    <option value="Store">MOD_PPOSMAP_SCHEMA_TYPE_STORE</option>
                    <option value="Restaurant">MOD_PPOSMAP_SCHEMA_TYPE_RESTAURANT</option>
                    <option value="MedicalBusiness">MOD_PPOSMAP_SCHEMA_TYPE_MEDICALBUSINESS</option>
                    <option value="AutomotiveBusiness">MOD_PPOSMAP_SCHEMA_TYPE_AUTOMOTIVEBUSINESS</option>
                    <option value="ProfessionalService">MOD_PPOSMAP_SCHEMA_TYPE_PROFESSIONALSERVICE</option>
                    <option value="LodgingBusiness">MOD_PPOSMAP_SCHEMA_TYPE_LODGINGBUSINESS</option>
                </field>
                <field
                    name="schemamenuitems"
                    type="menuitem"
                    multiple="true"
                    default=""
                    label="MOD_PPOSMAP_SCHEMA_MENU_ITEMS"
                    description="MOD_PPOSMAP_SCHEMA_MENU_ITEMS_DESC"
                    showon="addschema:1"
                />
                <field
                    name="schemaownlocations"
                    type="radio"
                    default="0"
                    label="MOD_PPOSMAP_SCHEMA_OWN_LOCATIONS"
                    description="MOD_PPOSMAP_SCHEMA_OWN_LOCATIONS_DESC"
                    showon="addschema:1[AND]schematype!:Place,TouristAttraction"
                    layout="joomla.form.field.radio.switcher">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="addresscountry"
                    type="text"
                    default=""
                    label="MOD_PPOSMAP_ADDRESS_COUNTRY"
                    description="MOD_PPOSMAP_ADDRESS_COUNTRY_DESC"
                    showon="addschema:1"
                    filter="string"
                />
                <field
                    name="clustermarkers"
                    type="radio"
                    default="0"
                    label="MOD_PPOSMAP_CLUSTER_MARKERS"
                    description="MOD_PPOSMAP_CLUSTER_MARKERS_DESC"
                    layout="joomla.form.field.radio.switcher">
                    <option value="0">JHIDE</option>
                    <option value="1">JSHOW</option>
                </field>
            </fieldset>
            <fieldset name="geojson" label="MOD_PPOSMAP_FIELDSET_GEOJSON">
                <field
                    name="geojsonsource"
                    type="list"
                    default="0"
                    label="MOD_PPOSMAP_GEOJSON_SOURCE"
                    description="MOD_PPOSMAP_GEOJSON_SOURCE_DESC"
                >
                    <option value="0">MOD_PPOSMAP_GEOJSON_SOURCE_NONE</option>
                    <option value="1">MOD_PPOSMAP_GEOJSON_SOURCE_PASTE</option>
                    <option value="2">MOD_PPOSMAP_GEOJSON_SOURCE_FILE</option>
                </field>
                <!--
                    filter="raw" jest tu konieczne: safehtml/string rozbijają JSON
                    (encodują cudzysłowy, wycinają < i >), a plik przestaje się parsować.
                    Treść jest w całości filtrowana po stronie PHP w tmpl/default.php —
                    tytuły przez strip_tags, opisy przez InputFilter w trybie safehtml.
                -->
                <field
                    name="geojsondata"
                    type="textarea"
                    rows="12"
                    default=""
                    label="MOD_PPOSMAP_GEOJSON_DATA"
                    description="MOD_PPOSMAP_GEOJSON_DATA_DESC"
                    showon="geojsonsource:1"
                    filter="raw"
                />
                <field
                    name="geojsonfile"
                    type="text"
                    default=""
                    label="MOD_PPOSMAP_GEOJSON_FILE"
                    description="MOD_PPOSMAP_GEOJSON_FILE_DESC"
                    showon="geojsonsource:2"
                    filter="string"
                />
                <field
                    name="geojsonfit"
                    type="radio"
                    default="1"
                    label="MOD_PPOSMAP_GEOJSON_FIT"
                    description="MOD_PPOSMAP_GEOJSON_FIT_DESC"
                    showon="geojsonsource!:0"
                    layout="joomla.form.field.radio.switcher">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="geojsonstylespacer"
                    type="note"
                    heading="h4"
                    label="MOD_PPOSMAP_GEOJSON_STYLE_LABEL"
                    description="MOD_PPOSMAP_GEOJSON_STYLE_DESC"
                    showon="geojsonsource!:0"
                />
                <field
                    name="geojsonstroke"
                    type="color"
                    default="#3388ff"
                    label="MOD_PPOSMAP_GEOJSON_STROKE"
                    description="MOD_PPOSMAP_GEOJSON_STROKE_DESC"
                    showon="geojsonsource!:0"
                />
                <field
                    name="geojsonstrokewidth"
                    type="number"
                    default="3"
                    min="0"
                    max="20"
                    step="0.5"
                    label="MOD_PPOSMAP_GEOJSON_STROKE_WIDTH"
                    showon="geojsonsource!:0"
                />
                <field
                    name="geojsonstrokeopacity"
                    type="number"
                    default="1"
                    min="0"
                    max="1"
                    step="0.05"
                    label="MOD_PPOSMAP_GEOJSON_STROKE_OPACITY"
                    showon="geojsonsource!:0"
                />
                <field
                    name="geojsonfill"
                    type="color"
                    default="#3388ff"
                    label="MOD_PPOSMAP_GEOJSON_FILL"
                    description="MOD_PPOSMAP_GEOJSON_FILL_DESC"
                    showon="geojsonsource!:0"
                />
                <field
                    name="geojsonfillopacity"
                    type="number"
                    default="0.2"
                    min="0"
                    max="1"
                    step="0.05"
                    label="MOD_PPOSMAP_GEOJSON_FILL_OPACITY"
                    description="MOD_PPOSMAP_GEOJSON_FILL_OPACITY_DESC"
                    showon="geojsonsource!:0"
                />

                <field
                    name="geojsonmappingspacer"
                    type="note"
                    heading="h4"
                    label="MOD_PPOSMAP_GEOJSON_MAPPING_LABEL"
                    description="MOD_PPOSMAP_GEOJSON_MAPPING_DESC"
                    showon="geojsonsource!:0"
                />
                <field
                    name="geojsonprop_title"
                    type="text"
                    default="name"
                    label="MOD_PPOSMAP_GEOJSON_PROP_TITLE"
                    showon="geojsonsource!:0"
                    filter="string"
                />
                <field
                    name="geojsonprop_description"
                    type="text"
                    default="description"
                    label="MOD_PPOSMAP_GEOJSON_PROP_DESCRIPTION"
                    showon="geojsonsource!:0"
                    filter="string"
                />
                <field
                    name="geojsonprop_telephone"
                    type="text"
                    default="phone"
                    label="MOD_PPOSMAP_GEOJSON_PROP_TELEPHONE"
                    showon="geojsonsource!:0"
                    filter="string"
                />
                <field
                    name="geojsonprop_openinghours"
                    type="text"
                    default="opening_hours"
                    label="MOD_PPOSMAP_GEOJSON_PROP_OPENINGHOURS"
                    description="MOD_PPOSMAP_GEOJSON_PROP_OPENINGHOURS_DESC"
                    showon="geojsonsource!:0"
                    filter="string"
                />
                <field
                    name="geojsonprop_image"
                    type="text"
                    default="image"
                    label="MOD_PPOSMAP_GEOJSON_PROP_IMAGE"
                    description="MOD_PPOSMAP_GEOJSON_PROP_IMAGE_DESC"
                    showon="geojsonsource!:0"
                    filter="string"
                />
                <field
                    name="geojsonprop_group"
                    type="text"
                    default=""
                    label="MOD_PPOSMAP_GEOJSON_PROP_GROUP"
                    description="MOD_PPOSMAP_GEOJSON_PROP_GROUP_DESC"
                    showon="geojsonsource!:0"
                    filter="string"
                />

                <field
                    name="geojsonschema"
                    type="radio"
                    default="1"
                    label="MOD_PPOSMAP_GEOJSON_SCHEMA"
                    description="MOD_PPOSMAP_GEOJSON_SCHEMA_DESC"
                    showon="geojsonsource!:0"
                    layout="joomla.form.field.radio.switcher">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="geojsonprop_street"
                    type="text"
                    default="addr:street"
                    label="MOD_PPOSMAP_GEOJSON_PROP_STREET"
                    showon="geojsonsource!:0[AND]geojsonschema:1"
                    filter="string"
                />
                <field
                    name="geojsonprop_postalcode"
                    type="text"
                    default="addr:postcode"
                    label="MOD_PPOSMAP_GEOJSON_PROP_POSTALCODE"
                    showon="geojsonsource!:0[AND]geojsonschema:1"
                    filter="string"
                />
                <field
                    name="geojsonprop_locality"
                    type="text"
                    default="addr:city"
                    label="MOD_PPOSMAP_GEOJSON_PROP_LOCALITY"
                    showon="geojsonsource!:0[AND]geojsonschema:1"
                    filter="string"
                />
                <field
                    name="geojsonprop_url"
                    type="text"
                    default="website"
                    label="MOD_PPOSMAP_GEOJSON_PROP_URL"
                    showon="geojsonsource!:0[AND]geojsonschema:1"
                    filter="string"
                />
            </fieldset>
            <fieldset name="about" label="MOD_PPOSMAP_FIELDSET_ABOUT">
                <field
                    name="pposmap_about_intro"
                    type="note"
                    heading="h3"
                    label="MOD_PPOSMAP_ABOUT_INTRO_LABEL"
                    description="MOD_PPOSMAP_ABOUT_INTRO_DESC"
                />
                <field
                    name="pposmap_about_start"
                    type="note"
                    heading="h4"
                    label="MOD_PPOSMAP_ABOUT_START_LABEL"
                    description="MOD_PPOSMAP_ABOUT_START_DESC"
                />
                <field
                    name="pposmap_about_gotchas"
                    type="note"
                    heading="h4"
                    label="MOD_PPOSMAP_ABOUT_GOTCHAS_LABEL"
                    description="MOD_PPOSMAP_ABOUT_GOTCHAS_DESC"
                />
                <field
                    name="pposmap_about_tiles"
                    type="note"
                    heading="h4"
                    class="alert alert-warning w-100"
                    label="MOD_PPOSMAP_ABOUT_TILES_LABEL"
                    description="MOD_PPOSMAP_ABOUT_TILES_DESC"
                />
                <field
                    name="pposmap_about_schema"
                    type="note"
                    heading="h4"
                    label="MOD_PPOSMAP_ABOUT_SCHEMA_LABEL"
                    description="MOD_PPOSMAP_ABOUT_SCHEMA_DESC"
                />
                <field
                    name="pposmap_about_geojson"
                    type="note"
                    heading="h4"
                    label="MOD_PPOSMAP_ABOUT_GEOJSON_LABEL"
                    description="MOD_PPOSMAP_ABOUT_GEOJSON_DESC"
                />
                <field
                    name="pposmap_about_updates"
                    type="note"
                    heading="h4"
                    class="alert alert-info w-100"
                    label="MOD_PPOSMAP_ABOUT_UPDATES_LABEL"
                    description="MOD_PPOSMAP_ABOUT_UPDATES_DESC"
                />
                <field
                    name="pposmap_credit"
                    type="note"
                    heading="h4"
                    label="MOD_PPOSMAP_CREDIT_LABEL"
                    description="MOD_PPOSMAP_CREDIT_DESC"
                />
            </fieldset>
        </fields>
    </config>
    <updateservers>
        <server type="extension" name="Pposmap Module Updates">
            https://raw.githubusercontent.com/pablop76/mod_pposmap/release/updates.xml</server>
    </updateservers>
</extension>