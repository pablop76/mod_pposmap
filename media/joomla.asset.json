{
  "$schema": "https://developer.joomla.org/schemas/json-schema/web_assets.json",
  "name": "mod_pposmap",
  "version": "1.4.0",
  "description": "Joomla Module OpenStreetMap",
  "license": "GPL-2.0-or-later",
  "assets": [
    {
      "name": "leafletjs",
      "type": "script",
      "uri": "mod_pposmap/vendor/leaflet/leaflet.js",
      "dependencies": [
        "core"
      ],
      "version": "1.9.4"
    },
    {
      "name": "mod_pposmap.custom",
      "type": "script",
      "uri": "mod_pposmap/custom.js",
      "dependencies": [
        "core"
      ],
      "version": "1.4.0"
    },
    {
      "name": "mod_pposmap.admin",
      "type": "script",
      "uri": "mod_pposmap/admin.js",
      "dependencies": [
        "core"
      ],
      "version": "1.4.0"
    },
    {
      "name": "leafletmarkercluster",
      "type": "script",
      "uri": "mod_pposmap/vendor/leaflet.markercluster/leaflet.markercluster.js",
      "dependencies": [
        "leafletjs"
      ],
      "version": "1.5.3"
    },
    {
      "name": "mapboxgljs",
      "type": "script",
      "uri": "https://api.mapbox.com/mapbox-gl-js/v3.25.0/mapbox-gl.js",
      "dependencies": [
        "core"
      ],
      "version": "3.25.0"
    },
    {
      "name": "leafletcss",
      "type": "style",
      "uri": "mod_pposmap/vendor/leaflet/leaflet.css",
      "version": "1.9.4"
    },
    {
      "name": "mod_pposmap.style",
      "type": "style",
      "uri": "mod_pposmap/style.css",
      "version": "1.4.0"
    },
    {
      "name": "mapboxglcss",
      "type": "style",
      "uri": "https://api.mapbox.com/mapbox-gl-js/v3.25.0/mapbox-gl.css",
      "version": "3.25.0"
    },
    {
      "name": "leafletmarkerclustercss",
      "type": "style",
      "uri": "mod_pposmap/vendor/leaflet.markercluster/MarkerCluster.css",
      "version": "1.5.3"
    },
    {
      "name": "leafletmarkerclusterdefaultcss",
      "type": "style",
      "uri": "mod_pposmap/vendor/leaflet.markercluster/MarkerCluster.Default.css",
      "version": "1.5.3"
    }
  ]
}
